{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": ["WEB_PORT", "ADMIN_PORT", "API_PORT"]
    },
    "lint": {},
    "format": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {}
  }
}
