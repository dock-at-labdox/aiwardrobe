{
  "name": "@aiwardrobe/admin",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/run.mjs --port-var ADMIN_PORT --port-default 3001 -- next dev",
    "build": "next build",
    "start": "node ../../scripts/run.mjs --port-var ADMIN_PORT --port-default 3001 -- next start",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aiwardrobe/shared-web": "workspace:*",
    "@tanstack/react-query": "5.87.4",
    "next": "15.5.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwindcss": "4.1.13",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@aiwardrobe/shared-config": "workspace:*",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint-config-next": "15.5.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
