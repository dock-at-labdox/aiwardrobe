# Copy to apps/backend/.env for local development.
# Never add credentials to this file. Configure secret values in the platform secret store.

APP_ENV=development
API_PORT=4000
OTEL_SERVICE_NAME=aiwardrobe-api

DATABASE_URL=postgresql://aiwardrobe:CHANGE_ME@localhost:5432/aiwardrobe_dev
REDIS_URL=redis://localhost:6379
# Auth0
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.attireiq