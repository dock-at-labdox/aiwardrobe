{
  "name": "@aiwardrobe/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/run.mjs --port-var WEB_PORT --port-default 3000 -- next dev",
    "build": "next build",
    "start": "node ../../scripts/run.mjs --port-var WEB_PORT --port-default 3000 -- next start",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aiwardrobe/shared-web": "workspace:*",
    "@base-ui/react": "^1.7.0",
    "@tanstack/react-query": "5.87.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "15.5.21",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "7.62.0",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.1.13",
    "tw-animate-css": "^1.4.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@aiwardrobe/shared-config": "workspace:*",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint-config-next": "15.5.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
